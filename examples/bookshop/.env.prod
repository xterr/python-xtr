# .env.prod — committed, read when APP_ENV=prod. No secrets here: real values come from the
# process environment (which always wins) or the secrets/ directory loader.
SHOP_NAME="The Bookshop"
SHOP_LOG_LEVEL=warning
SHOP_PAYMENT_API_KEY=pk_live_placeholder_0000
MAILER_DSN=smtp://mailer.bookshop.example:587
# PostgreSQL through asyncpg; pool_size is an engine option the orm takes out of the URL.
SHOP_DATABASE_URL=postgresql+asyncpg://bookshop:${DATABASE_PASSWORD:-change-me}@${SHOP_HOST}:5432/bookshop?pool_size=10&pool_pre_ping=true
# The orders limiter counts in Redis, atomically on the server; elsewhere in the cache pool.
SHOP_RATE_LIMIT_STORAGE=redis://${SHOP_HOST}:6379/3
