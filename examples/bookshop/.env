# =====================================================================================
# .env — committed defaults for every environment. The base of the cascade.
# =====================================================================================
#
# Loaded by bookshop.kernel.load_environment() -> Dotenv().boot_env(".env"), in order:
#
#   1. .env                (this file; .env.dist is read instead when .env is missing)
#   2. .env.local          (per-machine overrides — skipped when APP_ENV is a test env)
#   3. .env.$APP_ENV       (.env.dev, .env.test, .env.prod)
#   4. .env.$APP_ENV.local (per-machine overrides for one environment)
#
# Later files override earlier ones. A REAL environment variable always wins over every
# file:   APP_ENV=prod uv run bookshop env:show
# When .env.local.json exists (written by `bookshop dotenv:dump`) and names the current
# environment, boot_env reads that one file instead of the cascade.
#
# Expansion, done once every file is read:
#   $VAR  ${VAR}        the value of VAR (empty when unset)
#   ${VAR:-default}     default when VAR is unset or empty
#   ${VAR:=default}     the same, and VAR is set to default for later lookups
#   \$                  a literal dollar sign (double-quoted or unquoted values)
#   'single quotes'     never expanded
#   $(command)          kept as text — never run
#
# Variables the xtr packages read themselves:
#   APP_ENV            the kernel's environment (dev | test | prod here; default dev)
#   APP_DEBUG          the kernel's debug flag; boot_env writes 1/0 (not prod -> 1)
#   SHELL_VERBOSITY    the console's starting verbosity, -2 (silent) .. 3 (debug);
#                      a -q / -v flag wins, and `run()` writes the result back
#   XTR_DOTENV_VARS    written by the loader: which names came from a file
#   XTR_DOTENV_PATH    written by the loader: the base .env path
# Everything else below is read by the application, through env() / Autowire(env=...).
# =====================================================================================

APP_ENV=dev
# APP_DEBUG=1
# SHELL_VERBOSITY=0

# ---- identity ---------------------------------------------------------------------
SHOP_NAME="The Bookshop"
SHOP_HOST=localhost
SHOP_SUPPORT_EMAIL=support@${SHOP_HOST}
# Empty: `default:shop.fallback_name:SHOP_NICKNAME` falls back to the parameter,
# `default::SHOP_NICKNAME` to None, and `defined:SHOP_NICKNAME` is false.
SHOP_NICKNAME=
APP_TIMEZONE=Europe/Bucharest

# ---- one variable per env processor (bookshop env:show prints them all) ----------
SHOP_MAINTENANCE=0                              # bool: / not:
SHOP_PAGE_SIZE=20                               # int:
SHOP_MEMBER_DISCOUNT=0.05                       # float:
SHOP_MOTTO="   Read more, worry less.   "       # trim:
SHOP_SEARCH_HINT="books & more"                 # urlencode:
SHOP_API_KEY_B64=c2stdGVzdC1ib29rc2hvcC0xMjM0     # base64: -> sk-test-bookshop-1234
SHOP_FEATURES='{"gift_wrap": true, "reviews": false}'   # json: (single quotes: literal)
SHOP_CURRENCIES=EUR,USD,RON                     # csv:
SHOP_MIRRORS=eu.mirror.example,us.mirror.example,ap.mirror.example  # shuffle:csv:
SHOP_TIER=pro                                   # enum:bookshop.env.tier.Tier:
SHOP_ROUNDING=decimal.ROUND_HALF_UP             # const: (a module.NAME path)
SHOP_HIDDEN_MESSAGE="Uryyb sebz gur obbxfubc"   # rot13: (the application's own prefix)
SHOP_FREE_SHIPPING_OVER=49.90                   # env("...", Decimal): a callable cast
# `resolve:` replaces %parameter% and %env(NAME)% references inside the value:
SHOP_LOG_PATTERN=%shop.log_dir%/shop-%env(APP_ENV)%.log
# `file:resolve:` — resolve the %...% references in the path, then read the file:
SHOP_BANNER_FILE=%kernel.project_dir%/resources/banner.txt
# `key:api_token:json:file:resolve:` — resolve, read, decode JSON, take one key:
SHOP_SECRETS_FILE=%kernel.project_dir%/resources/secrets.json
# SHOP_VAULT_TOKEN is deliberately NOT set anywhere: SecretsDirectoryLoader reads it from
# secrets/SHOP_VAULT_TOKEN when the environment lacks it.

# ---- url: / key:host:url: / query_string:key:query:url: -------------------------
DATABASE_URL=postgresql://bookshop:${DATABASE_PASSWORD:-change-me}@${SHOP_HOST}:5432/bookshop?sslmode=disable&pool_size=5

# ---- pricing, fraud, logging, search --------------------------------------------
SHOP_FRAUD_LIMIT=500
SHOP_LOG_LEVEL=debug
SEARCH_MAX_RESULTS=5
SEARCH_MIN_SCORE=0.25
SEARCH_SLOW_QUERY_MS=25

# ---- prod-only services; read only where they are built -------------------------
# ${VAR:=default}: keeps a real MESSENGER_TRANSPORT_DSN, else sets this one.
MESSENGER_TRANSPORT_DSN=${MESSENGER_TRANSPORT_DSN:=amqp://guest:guest@localhost:5672/%2f}
MAILER_DSN=smtp://mailer.internal:587
SHOP_PAYMENT_API_KEY=

# ---- quoting and escaping, for reference ----------------------------------------
SHOP_PRICE_NOTE="Prices shown in \$ are estimates"
SHOP_PASSWORD_HINT='p@$$w0rd stays exactly as written'
SHOP_BUILD_USER=$(whoami)
SHOP_WELCOME="Welcome to ${SHOP_NAME}.
Mind the step."

# ---- web (bookshop-web) ------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8080
