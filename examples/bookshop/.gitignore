# What the example writes while it runs.
/var/
# Per-machine overrides of the .env cascade; one machine's values are not another's.
/.env.local
/.env.*.local
# Written by `bookshop dotenv:dump`; regenerate it rather than commit it.
/.env.local.json
/.venv/
# JWT signing keys written by `jwt:generate-keypair` — a private key never enters the repository.
/secrets/*.pem
/secrets/*.jwks.json
