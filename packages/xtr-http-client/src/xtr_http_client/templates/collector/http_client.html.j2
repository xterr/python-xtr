{#
  Every request the application sent out while this one was handled.

  A record is written the moment a request is made and filled in as it goes
  on, so one still being answered when the profile was read shows what it
  asked for and no answer yet. A request counts as failed when it came back
  with a status of 400 or more, or when nothing came back at all.
  Credentials — an authorization or cookie header, a body field named like a
  password, a secret or a token — were kept as `******`.
#}
{% block toolbar %}
{% from "@xtr_web_profiler/profiler/toolbar_item.html.j2" import toolbar_item %}
{% set count = collector.data.get("count") or 0 %}
{% set broken = collector.data.get("errors") or 0 %}
{% set icon %}
<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
  <path d="M9.6 2.5h4v4"></path>
  <path d="M13.6 2.5L8.2 7.9"></path>
  <path d="M11.6 9.2v3.1a1.2 1.2 0 0 1-1.2 1.2H3.7a1.2 1.2 0 0 1-1.2-1.2V5.6a1.2 1.2 0 0 1 1.2-1.2h3.1"></path>
</svg>
<span class="xtr-toolbar-value">{{ count }}</span>
<span class="xtr-toolbar-sep">·</span>
<span class="xtr-toolbar-value">{{ collector.data.get("duration_ms")|format_ms }}</span>
{% endset %}
{% set text %}
<dl class="xtr-toolbar-rows">
  <dt>Requests</dt><dd>{{ count }}</dd>
  <dt>Failed</dt><dd>{{ broken }}</dd>
  <dt>Time</dt><dd>{{ collector.data.get("duration_ms")|format_ms }}</dd>
</dl>
<p class="xtr-toolbar-note">The transfers the application made itself, not the requests a page sends afterwards.</p>
{% endset %}
{{ toolbar_item(collector.name, icon, text, link=panel_url(collector.name), status="red" if broken else "normal") }}
{% endblock %}

{% block menu %}
<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
  <path d="M9.6 2.5h4v4"></path>
  <path d="M13.6 2.5L8.2 7.9"></path>
  <path d="M11.6 9.2v3.1a1.2 1.2 0 0 1-1.2 1.2H3.7a1.2 1.2 0 0 1-1.2-1.2V5.6a1.2 1.2 0 0 1 1.2-1.2h3.1"></path>
</svg>
<span class="xtr-menu-label">Outgoing requests</span>
{% if collector.data.get("errors") %}
<span class="xtr-menu-count xtr-menu-count-red" title="requests that failed">{{ collector.data.get("errors") }}</span>
{% else %}
<span class="xtr-menu-count">{{ collector.data.get("count") or 0 }}</span>
{% endif %}
{% endblock %}

{% block panel %}
{% set requests = collector.data.get("requests") or [] %}
{% set broken = [] %}
{% set clients = [] %}
{% for entry in requests %}
{% if entry.get("error") is not none or (entry.get("status") is not none and entry.get("status") >= 400) %}
{% set _ = broken.append(entry) %}
{% endif %}
{% if entry.get("client") not in clients %}
{% set _ = clients.append(entry.get("client")) %}
{% endif %}
{% endfor %}
{% macro header_lines(label, rows) %}
{% if rows %}
<details class="xtr-dump">
  <summary><span class="xtr-dump-type">{{ label }}</span> <span class="xtr-dump-count">({{ rows|length }})</span></summary>
  <ul>
    {% for line in rows %}
    <li><span class="xtr-dump-scalar">{{ line }}</span></li>
    {% endfor %}
  </ul>
</details>
{% endif %}
{% endmacro %}
{% macro sent_body(node) %}
{% if node is not none %}
<details class="xtr-dump">
  <summary><span class="xtr-dump-type">request body</span></summary>
  <ul>
    <li>{{ node|profiler_dump }}</li>
  </ul>
</details>
{% endif %}
{% endmacro %}
{% macro request_rows(tag, rows, nothing) %}
<div class="xtr-toolstrip">
  <input class="xtr-filter" type="search" placeholder="Filter these requests…" aria-label="Filter the requests shown" data-xtr-filter="xtr-http-client-{{ tag }}" data-xtr-filter-count="xtr-http-client-{{ tag }}-count">
  <span class="xtr-card-note" id="xtr-http-client-{{ tag }}-count">{{ rows|length }} of {{ rows|length }}</span>
</div>
{% if rows %}
<div class="xtr-scroll">
  <table class="xtr-table" id="xtr-http-client-{{ tag }}">
    <thead>
      <tr>
        <th scope="col">Client</th>
        <th scope="col">Method</th>
        <th scope="col">URL</th>
        <th scope="col">Status</th>
        <th scope="col">Took</th>
        <th scope="col">Size</th>
        <th scope="col">Details</th>
      </tr>
    </thead>
    <tbody>
      {% for entry in rows %}
      {% set code = entry.get("status") %}
      {% set tone = "green" if (code is not none and 200 <= code < 300) else ("yellow" if (code is not none and 300 <= code < 400) else ("red" if (code is not none and code >= 400) else "")) %}
      {% set sent = entry.get("request_headers") or [] %}
      {% set back = entry.get("response_headers") or [] %}
      {% set body = entry.get("request_body") %}
      <tr>
        <td class="xtr-cell-mono">{{ entry.get("client") or "—" }}</td>
        <td class="xtr-cell-tight"><span class="xtr-method">{{ entry.get("method") or "?" }}</span></td>
        <td class="xtr-cell-mono xtr-break">
          {{ entry.get("url") or "—" }}
          {% if entry.get("error") is not none %}
          <div class="xtr-card-note xtr-break">{{ entry.get("error") }}</div>
          {% endif %}
        </td>
        <td class="xtr-cell-tight">
          {% if code is not none %}
          <span class="xtr-badge{% if tone %} xtr-badge-{{ tone }}{% endif %}">{{ code }}</span>
          {% elif entry.get("error") is not none %}
          <span class="xtr-badge xtr-badge-red">no answer</span>
          {% else %}
          <span class="xtr-badge">unanswered</span>
          {% endif %}
        </td>
        <td class="xtr-cell-num">{{ entry.get("duration_ms")|format_ms }}</td>
        <td class="xtr-cell-num">
          {% if entry.get("content_traced") %}
          {{ entry.get("response_size")|format_bytes }}
          {% else %}
          <span class="xtr-dump-null">not kept</span>
          {% endif %}
        </td>
        <td>
          {{ header_lines("request headers", sent) }}
          {{ sent_body(body) }}
          {{ header_lines("response headers", back) }}
          {% if not (sent or back or body is not none) %}
          <span class="xtr-dump-null">none</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<p class="xtr-empty">{{ nothing }}</p>
{% endif %}
{% endmacro %}
<h1 class="xtr-panel-title">Outgoing requests</h1>
<section class="xtr-card">
  <div class="xtr-card-body">
    <table class="xtr-table xtr-table-key">
      <tbody>
        <tr><td>Requests</td><td class="xtr-cell-mono">{{ collector.data.get("count") or 0 }}</td></tr>
        <tr><td>Failed</td><td class="xtr-cell-mono">{{ collector.data.get("errors") or 0 }}</td></tr>
        <tr><td>Time</td><td class="xtr-cell-mono">{{ collector.data.get("duration_ms")|format_ms }}</td></tr>
        <tr><td>Clients</td><td class="xtr-cell-mono">{{ clients|length }}</td></tr>
      </tbody>
    </table>
    <p class="xtr-card-note">
      The time is what the transfers reported, added up. Requests made one
      after another add up to about the time this request spent waiting for
      them; requests made at once add up to more than it. A transfer that
      never reported — nothing came back — adds nothing.
    </p>
  </div>
</section>
<section class="xtr-card">
  <header class="xtr-card-head">
    <h2 class="xtr-card-title">Clients</h2>
    <span class="xtr-card-note">every client service this request sent through</span>
  </header>
  <div class="xtr-card-body">
    {% if clients %}
    <table class="xtr-table">
      <thead>
        <tr>
          <th scope="col">Client</th>
          <th scope="col">Requests</th>
          <th scope="col">Failed</th>
          <th scope="col">Time</th>
        </tr>
      </thead>
      <tbody>
        {% for name in clients %}
        {% set own = requests|selectattr("client", "equalto", name)|list %}
        <tr>
          <td class="xtr-cell-mono xtr-break">{{ name or "—" }}</td>
          <td class="xtr-cell-num">{{ own|length }}</td>
          <td class="xtr-cell-num">{{ broken|selectattr("client", "equalto", name)|list|length }}</td>
          <td class="xtr-cell-num">{{ own|rejectattr("duration_ms", "none")|sum(attribute="duration_ms")|format_ms }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="xtr-card-note">This request sent nothing, so no client is listed.</p>
    {% endif %}
  </div>
</section>
<section class="xtr-card xtr-card-flush xtr-tabs">
  <div class="xtr-tablist" role="tablist" aria-label="Which requests to show">
    <button type="button" class="xtr-tab xtr-on" data-xtr-tab="all" role="tab" aria-selected="true">All<span class="xtr-tab-count">{{ requests|length }}</span></button>
    <button type="button" class="xtr-tab" data-xtr-tab="failed" role="tab" aria-selected="false">Failed<span class="xtr-tab-count">{{ broken|length }}</span></button>
  </div>
  <section class="xtr-pane xtr-pane-flush xtr-on" data-xtr-pane="all" role="tabpanel">
    {{ request_rows("all", requests, "This request sent none of its own.") }}
  </section>
  <section class="xtr-pane xtr-pane-flush" data-xtr-pane="failed" role="tabpanel">
    {{ request_rows("failed", broken, "Every request came back with an answer under 400.") }}
  </section>
  <p class="xtr-card-foot">
    <span class="xtr-badge">unanswered</span> the request was still being
    answered when this profile was read.
    <span class="xtr-badge xtr-badge-red">no answer</span> nothing came back
    at all, and the reason is under the address.
    <span class="xtr-dump-null">not kept</span> the request asked for its
    bodies to be left out, so neither what it sent nor the size of what came
    back was recorded.
  </p>
</section>
{% endblock %}
