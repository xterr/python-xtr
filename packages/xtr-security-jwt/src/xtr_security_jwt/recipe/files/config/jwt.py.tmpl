"""The self-issued tokens: the key that signs them, and how they are read back.

``secret_key`` takes the key text or the path of a file holding it — the bundle's key loader
reads the file itself — so what ``JWT_SECRET_KEY_PATH`` carries is a path, and no key material is
written into the repository. ``resolve:`` expands the ``%kernel.project_dir%`` in it.

The application builds and boots before the file exists, so its console can mint one:
``jwt:generate-keypair --kid jwt --output-dir secrets``. Signing or verifying a token without it
raises ``MissingKeyError``; ``jwt:check-config`` says the same before a request does. A
deployment mounts its own key and points ``JWT_SECRET_KEY_PATH`` at it.

Everything else keeps its default: the kernel's name as the issuer, ``RS256``, an hour's
lifetime, the user named by the ``username`` claim, a token read from the authorization header.
The README's *Configure* table has the fields to change, and a firewall accepts these tokens once
it lists ``JwtAuthenticatorConfig()`` under its ``authenticators``.
"""

from __future__ import annotations

from xtr_dependency_injection import configure, env
from xtr_security_jwt.bundle import JwtConfig

__all__ = ["jwt"]


@configure
def jwt() -> JwtConfig:
    """Sign with the key ``JWT_SECRET_KEY_PATH`` points at."""
    return JwtConfig(secret_key=env("resolve:JWT_SECRET_KEY_PATH"))
