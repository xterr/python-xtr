[project]
name = "${name}"
version = "0.1.0"
description = "A console application on the xtr packages."
readme = "README.md"
requires-python = ">=${python}"
dependencies = []

[project.scripts]
${name} = "${app}.__main__:main"

[dependency-groups]
dev = []

[build-system]
requires = ["uv_build>=0.9.18,<0.10.0"]
build-backend = "uv_build"

[tool.basedpyright]
typeCheckingMode = "all"
pythonVersion = "${python}"
include = ["src", "tests"]
exclude = ["**/__pycache__", "**/.venv", "var"]
reportUnusedCallResult = "warning"

[tool.ruff]
target-version = "py3${minor}"
line-length = 100
src = ["src", "tests"]

[tool.ruff.lint]
select = ["ALL"]
ignore = [
    # Formatter conflicts.
    "COM812",
    "ISC001",
    # Mutually exclusive docstring conventions; keep the modern one.
    "D203",
    "D213",
    "CPY001",
    # The container and the console read annotations at runtime: an import used only in
    # an annotation is still needed at runtime, so none may move under TYPE_CHECKING.
    "TC001",
    "TC002",
    "TC003",
]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["S101", "D"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ty.src]
include = ["src", "tests"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["-ra", "--strict-config", "--strict-markers"]
