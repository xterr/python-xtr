{#
  Every record the request logged.

  A message may name values of its context in braces; where the context kept
  that value as text or as a plain scalar, the name is filled in, and where it
  did not, the braces are left to read as they were logged.
#}
{% block toolbar %}
{% from "@xtr_web_profiler/profiler/toolbar_item.html.j2" import toolbar_item %}
{% set records = collector.data.get("records") or [] %}
{% set errors = collector.data.get("error_count") or 0 %}
{% set warnings = collector.data.get("warning_count") or 0 %}
{% set status = "red" if errors else ("yellow" if warnings else "normal") %}
{% set icon %}
<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
  <path d="M3.5 2.5h9v11h-9z"></path>
  <path d="M5.8 5.4h4.4M5.8 8h4.4M5.8 10.6h2.6"></path>
</svg>
<span class="xtr-toolbar-value">{{ records|length }}</span>
{% endset %}
{% set text %}
<dl class="xtr-toolbar-rows">
  <dt>Records</dt><dd>{{ records|length }}</dd>
  <dt>Errors</dt><dd>{{ errors }}</dd>
  <dt>Warnings</dt><dd>{{ warnings }}</dd>
</dl>
<p class="xtr-toolbar-note">What this request's unit of work logged, the last lines of a streamed body included.</p>
{% endset %}
{{ toolbar_item(collector.name, icon, text, link=panel_url(collector.name), status=status) }}
{% endblock %}

{% block menu %}
<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
  <path d="M3.5 2.5h9v11h-9z"></path>
  <path d="M5.8 5.4h4.4M5.8 8h4.4M5.8 10.6h2.6"></path>
</svg>
<span class="xtr-menu-label">Logs</span>
{% if collector.data.get("error_count") %}
<span class="xtr-menu-count xtr-menu-count-red" title="errors">{{ collector.data.get("error_count") }}</span>
{% elif collector.data.get("warning_count") %}
<span class="xtr-menu-count xtr-menu-count-yellow" title="warnings">{{ collector.data.get("warning_count") }}</span>
{% else %}
<span class="xtr-menu-count">{{ (collector.data.get("records") or [])|length }}</span>
{% endif %}
{% endblock %}

{% block panel %}
{% set records = collector.data.get("records") or [] %}
{% set errors = [] %}
{% set warnings = [] %}
{% set debugs = [] %}
{% for record in records %}
{% if record.level in ("ERROR", "CRITICAL", "ALERT", "EMERGENCY") %}
{% set _ = errors.append(record) %}
{% endif %}
{% if record.level == "WARNING" %}
{% set _ = warnings.append(record) %}
{% endif %}
{% if record.level == "DEBUG" %}
{% set _ = debugs.append(record) %}
{% endif %}
{% endfor %}
{% macro records_table(tag, rows, nothing) %}
{% set tones = {"INFO": "blue", "NOTICE": "blue", "WARNING": "yellow", "ERROR": "red", "CRITICAL": "red", "ALERT": "red", "EMERGENCY": "red"} %}
<div class="xtr-toolstrip">
  <input class="xtr-filter" type="search" placeholder="Filter these records…" aria-label="Filter the records shown" data-xtr-filter="xtr-logger-{{ tag }}" data-xtr-filter-count="xtr-logger-{{ tag }}-count">
  <span class="xtr-card-note" id="xtr-logger-{{ tag }}-count">{{ rows|length }} of {{ rows|length }}</span>
</div>
{% if rows %}
<div class="xtr-scroll">
  <table class="xtr-table" id="xtr-logger-{{ tag }}">
    <thead>
      <tr>
        <th scope="col">Time</th>
        <th scope="col">Level</th>
        <th scope="col">Channel</th>
        <th scope="col">Message</th>
        <th scope="col">Context</th>
      </tr>
    </thead>
    <tbody>
      {% for record in rows %}
      {% set stamp = record.time|string %}
      {% set tone = tones.get(record.level, "") %}
      {% set filled = namespace(message=record.message|string) %}
      {% for name, value in (record.context or {}).items() %}
      {% if value is mapping and value.get("kind") in ("str", "scalar") and value.get("value") is not none %}
      {% set filled.message = filled.message|replace("{" ~ name ~ "}", value.get("value")|string) %}
      {% endif %}
      {% endfor %}
      <tr>
        <td class="xtr-cell-mono xtr-cell-tight" title="{{ stamp }}">{{ stamp.split("T")|last }}</td>
        <td class="xtr-cell-tight"><span class="xtr-badge{% if tone %} xtr-badge-{{ tone }}{% endif %}">{{ record.level }}</span></td>
        <td class="xtr-cell-mono">{{ record.channel }}</td>
        <td class="xtr-break">{{ filled.message }}</td>
        <td>
          {% if record.context %}
          <details class="xtr-dump">
            <summary><span class="xtr-dump-type">context</span> <span class="xtr-dump-count">({{ record.context|length }})</span></summary>
            <ul>
              {% for name, value in record.context.items() %}
              <li><span class="xtr-dump-key">{{ name }}</span>: {{ value|profiler_dump }}</li>
              {% endfor %}
            </ul>
          </details>
          {% else %}
          <span class="xtr-dump-null">none</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<p class="xtr-empty">{{ nothing }}</p>
{% endif %}
{% endmacro %}
<h1 class="xtr-panel-title">Logs</h1>
<section class="xtr-card">
  <div class="xtr-card-body">
    <table class="xtr-table xtr-table-key">
      <tbody>
        <tr><td>Records</td><td class="xtr-cell-mono">{{ records|length }}</td></tr>
        <tr><td>Errors</td><td class="xtr-cell-mono">{{ collector.data.get("error_count") or 0 }}</td></tr>
        <tr><td>Warnings</td><td class="xtr-cell-mono">{{ collector.data.get("warning_count") or 0 }}</td></tr>
      </tbody>
    </table>
  </div>
</section>
<section class="xtr-card xtr-card-flush xtr-tabs">
  <div class="xtr-tablist" role="tablist" aria-label="Which records to show">
    <button type="button" class="xtr-tab xtr-on" data-xtr-tab="all" role="tab" aria-selected="true">All<span class="xtr-tab-count">{{ records|length }}</span></button>
    <button type="button" class="xtr-tab" data-xtr-tab="errors" role="tab" aria-selected="false">Errors<span class="xtr-tab-count">{{ errors|length }}</span></button>
    <button type="button" class="xtr-tab" data-xtr-tab="warnings" role="tab" aria-selected="false">Warnings<span class="xtr-tab-count">{{ warnings|length }}</span></button>
    <button type="button" class="xtr-tab" data-xtr-tab="debug" role="tab" aria-selected="false">Debug<span class="xtr-tab-count">{{ debugs|length }}</span></button>
  </div>
  <section class="xtr-pane xtr-pane-flush xtr-on" data-xtr-pane="all" role="tabpanel">
    {{ records_table("all", records, "This request logged nothing.") }}
  </section>
  <section class="xtr-pane xtr-pane-flush" data-xtr-pane="errors" role="tabpanel">
    {{ records_table("errors", errors, "Nothing was logged at error level or above.") }}
  </section>
  <section class="xtr-pane xtr-pane-flush" data-xtr-pane="warnings" role="tabpanel">
    {{ records_table("warnings", warnings, "Nothing was logged as a warning.") }}
  </section>
  <section class="xtr-pane xtr-pane-flush" data-xtr-pane="debug" role="tabpanel">
    {{ records_table("debug", debugs, "Nothing was logged for debugging.") }}
  </section>
</section>
{% endblock %}
