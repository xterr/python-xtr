"""Where this application receives webhooks: ``POST /webhook/{type}`` by default.

Give each sender the URL built from the route's name, ``"webhook"``, rather than
writing the path out: a sender that was told a URL keeps sending to it long
after the deploy that moved it.
"""

from __future__ import annotations

from typing import TYPE_CHECKING

from xtr_http_kernel.routing.decorator import as_routes

if TYPE_CHECKING:
    from xtr_http_kernel.routing.loader.configurator import RoutingConfigurator

__all__ = ["webhook"]


@as_routes
def webhook(routes: RoutingConfigurator) -> None:
    """Serve the endpoint at its default path."""
    _ = routes.import_("webhook")
    # Keep everything a stranger may call under one path:
    # _ = routes.import_("webhook").prefix("/hooks")
